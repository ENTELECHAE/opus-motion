# Opus-Motion Environment Configuration Example
# Copy this file to .env and fill in your values.

# LLM Gateway / Proxy Settings (Compatible with OpenAI format & FreeLLMAPI)
BASE_URL=http://127.0.0.1:31415
LLM_API_KEY=your_freellmapi_or_openai_api_key_here
LLM_MODEL=Entelechae-code

# Server Port Configuration
PORT=5173

# Optional: Remote Proxy Endpoints (e.g., CLIProxyAPI on port 8317)
PROXY_PORT=8317
PROXY_HOST=127.0.0.1
